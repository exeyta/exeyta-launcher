/* ============================================================
   Exeyta Launcher - общий QSS (диалоги, вводы, прогресс, скролл).
   Палитра: графит + приглушённое золото (exeyta_shared/theme.py).
   ============================================================ */

* {
    font-family: "Segoe UI", Arial;
}

QToolTip {
    background: #24252b;
    color: #eceef2;
    border: 1px solid #3a3b43;
    padding: 5px 9px;
    border-radius: 7px;
    font-size: 12px;
}

QDialog {
    background: #17181d;
}

QLabel {
    background: transparent;
}

QLabel#dlgSub, QLabel#wzMsg, QLabel#dlgHint {
    color: #8b8f98;
}
QLabel#dlgHint {
    color: #d97a7a;
}
QLabel#dlgTitle, QLabel#wzTitle {
    color: #eceef2;
    font-size: 20px;
    font-weight: 700;
}
QLabel#wzStageTitle {
    color: #e8cf9a;
    font-size: 14px;
    font-weight: 700;
}
QLabel#wzPct {
    color: #e8cf9a;
    font-size: 13px;
    font-weight: 700;
}
QLabel#wzVersion {
    color: #7fbf8f;
    font-size: 13px;
}
QLabel#wzError {
    color: #d97a7a;
    font-size: 13px;
}

QLineEdit, QLineEdit#versionFilter {
    background: #1c1d22;
    border: 1px solid #2a2b31;
    border-radius: 9px;
    padding: 8px 12px;
    color: #eceef2;
    font-size: 13px;
    selection-background-color: #c9a45c;
    selection-color: #1c1609;
}
QLineEdit:focus, QLineEdit#versionFilter:focus {
    border: 1px solid #c9a45c;
}
QLineEdit:disabled {
    color: #62666e;
}

QListWidget, QListWidget#versionsList {
    background: #141519;
    border: 1px solid #2a2b31;
    border-radius: 10px;
    padding: 6px;
    color: #d6d9df;
    font-size: 13px;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 7px;
}
QListWidget::item:hover {
    background: rgba(255,255,255,0.05);
}
QListWidget::item:selected {
    background: rgba(201,164,92,0.14);
    color: #e8cf9a;
    border: 1px solid rgba(201,164,92,0.55);
}

QListWidget#versionPopup {
    background: #1c1d22;
    border: 1px solid #3a3b43;
    border-radius: 10px;
    padding: 6px;
    font-size: 14px;
}
QListWidget#versionPopup::item {
    padding: 8px 12px;
}
QListWidget#versionPopup::item:selected {
    background: rgba(201,164,92,0.14);
    color: #e8cf9a;
    border: none;
}

QProgressBar {
    background: #2a2b31;
    border: none;
    border-radius: 5px;
    text-align: center;
    color: #8b8f98;
}
QProgressBar#progressWiz {
    background: #2a2b31;
    border: none;
    border-radius: 7px;
    height: 14px;
}
QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a8843c, stop:1 #d3b06a);
}
QProgressBar#progressWiz::chunk {
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a8843c, stop:1 #d3b06a);
}

QCheckBox {
    color: #c7cad1;
    font-size: 13px;
    spacing: 10px;
    background: transparent;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid #3a3b43;
    background: #1c1d22;
}
QCheckBox::indicator:checked {
    background: #c9a45c;
    border: 1px solid #d8b56e;
}
QCheckBox:hover {
    color: #eceef2;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #34353c;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #c9a45c;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #34353c;
    border-radius: 5px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #c9a45c;
}

QPlainTextEdit, QTextEdit, QPlainTextEdit#consoleView {
    background: #121317;
    border: 1px solid #26272d;
    border-radius: 10px;
    color: #c7cad1;
    font-size: 12px;
    padding: 10px;
    selection-background-color: #c9a45c;
    selection-color: #1c1609;
}
