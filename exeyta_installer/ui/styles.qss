/* ============================================================
   ExeytaSetup — стили установщика (та же тема, что у лаунчера:
   графит + приглушённое золото; exeyta_shared/theme.py).
   ============================================================ */

* {
    font-family: "Segoe UI", Arial;
}

QWidget {
    background: transparent;
    color: #eceef2;
}

QToolTip {
    background: #24252b;
    color: #eceef2;
    border: 1px solid #3a3b43;
    padding: 5px 9px;
    border-radius: 7px;
    font-size: 12px;
}

QLabel {
    background: transparent;
    color: #eceef2;
}

QLineEdit {
    background: #1c1d22;
    border: 1px solid #2a2b31;
    border-radius: 10px;
    padding: 10px 14px;
    color: #eceef2;
    font-size: 14px;
    selection-background-color: #c9a45c;
    selection-color: #1c1609;
}
QLineEdit:focus {
    border: 1px solid #c9a45c;
}

QPlainTextEdit {
    background: #121317;
    border: 1px solid #26272d;
    border-radius: 10px;
    color: #c7cad1;
    font-size: 13px;
    padding: 8px;
    selection-background-color: #c9a45c;
    selection-color: #1c1609;
}

QCheckBox {
    color: #c7cad1;
    font-size: 14px;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid #3a3b43;
    background: #1c1d22;
}
QCheckBox::indicator:checked {
    background: #c9a45c;
    border: 1px solid #d8b56e;
}
QCheckBox:hover {
    color: #eceef2;
}

QProgressBar#progressWiz {
    background: #2a2b31;
    border: none;
    border-radius: 8px;
}
QProgressBar#progressWiz::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a8843c, stop:1 #d3b06a);
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #34353c;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #c9a45c;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
